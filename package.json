{
  "name": "picmake",
  "private": true,
  "version": "0.1.0",
  "description": "纯前端、数据全留本地的 GPT Image 2.5 图片生成工作台（浏览器直连 OpenAI 或兼容中转站）",
  "license": "MIT",
  "keywords": [
    "openai",
    "gpt-image",
    "image-generation",
    "react",
    "vite",
    "tailwindcss",
    "heroui",
    "dexie",
    "indexeddb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisweb1994/PicMake.git"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
