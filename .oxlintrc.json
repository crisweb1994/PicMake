{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zustand",
                "message": "展示组件只收 props，不订阅 store"
              },
              { "name": "dexie", "message": "展示组件不读写 IndexedDB" }
            ],
            "patterns": [
              {
                "group": [
                  "**/store/**",
                  "**/flows/**",
                  "**/api/**",
                  "**/db/**",
                  "**/hooks/**",
                  "**/containers/**"
                ],
                "allowTypeImports": true,
                "message": "展示组件只收 props"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "@heroui/react", "message": "store 不发 toast" },
              { "name": "react", "message": "store 不使用 React API" }
            ],
            "patterns": [
              {
                "group": [
                  "**/api/**",
                  "**/db/**",
                  "**/flows/**",
                  "**/hooks/**",
                  "**/containers/**",
                  "**/components/**"
                ],
                "allowTypeImports": true,
                "message": "store 不做 IO，只依赖 lib"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/store/**",
                  "**/flows/**",
                  "**/hooks/**",
                  "**/containers/**",
                  "**/components/**",
                  "**/api/**",
                  "**/db/**"
                ],
                "allowTypeImports": true,
                "message": "lib 只放纯函数"
              }
            ]
          }
        ]
      }
    }
  ]
}
